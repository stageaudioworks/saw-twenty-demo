# Copy to .env (install.sh does this and fills in the secrets).

# ---- Twenty ----
# The address people will open. With Cloudflare Tunnel use the public hostname, e.g. https://crm.stageaudioworks.com
SERVER_URL=http://localhost:3000
TWENTY_TAG=latest
TWENTY_PORT=3000
ENCRYPTION_KEY=
APP_SECRET=
PG_DATABASE_PASSWORD=

# First admin, created by setup. Change the password after first sign-in.
ADMIN_EMAIL=nathan@stageaudioworks.com
ADMIN_PASSWORD=
WORKSPACE_NAME="Stage Audio Works"

# Leave empty: setup creates a key and saves it in ./state/twenty.json.
# Set it only if you created the admin and key by hand in the UI.
TWENTY_API_KEY=

SEED_DEMO_DATA=true

# ---- SAP Business One ----
# Demo: the mock Service Layer in this pack. Phase 3: https://<b1-server>:50000/b1s/v1
B1_URL=http://mock-b1:50000/b1s/v1
B1_COMPANY_DB=SBODEMO_SAW
B1_USER=crm-sync
B1_PASSWORD=
# Real B1: add the B1 server's hostname or IP so Twenty may call it from workflows.
B1_HOST_ALLOWLIST=mock-b1
# Real B1 with a self-signed certificate: prefer mounting its CA and setting NODE_EXTRA_CA_CERTS.
B1_TLS_INSECURE=false
# false = the sync only reads from B1 (balances, stock, order status) and never writes.
B1_WRITE_ENABLED=true
# Item used for the single lump-sum line on quotations created from the CRM.
B1_LUMP_SUM_ITEM=PRJ-LUMPSUM

# ---- Sync service ----
WEBHOOK_SECRET=
SYNC_INTERVAL_SEC=60
ITEM_SYNC_INTERVAL_SEC=300
SYNC_STATUS_PORT=8088
B1_MOCK_PORT=50000

# ---- Optional ----
# Cloudflare Tunnel token (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
# Microsoft 365 mail + calendar (Azure app registration)
AUTH_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
